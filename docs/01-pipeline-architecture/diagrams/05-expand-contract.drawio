<mxfile host="app.diagrams.net"><diagram name="05-expand-contract" id="05-expand-contract"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1559" pageHeight="319"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="S0 original&lt;br&gt;email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#2F6DB5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="64" width="74" height="36" as="geometry"/></mxCell><mxCell id="4" value="EXPAND  V2.0&lt;br&gt;ADD encrypted_email (nullable)&lt;br&gt;CREATE INDEX CONCURRENTLY&lt;br&gt;lock_timeout 3 s · DBA gate&lt;br&gt;rollback: DROP COLUMN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2F6DB5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="157" y="48" width="191" height="68" as="geometry"/></mxCell><mxCell id="5" value="Deploy app N&lt;br&gt;dual-write email + encrypted_email&lt;br&gt;read email (fallback)&lt;br&gt;rollback: redeploy N-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F4E4;strokeColor=#3C8D40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="412" y="54" width="212" height="56" as="geometry"/></mxCell><mxCell id="6" value="MIGRATE  V2.1&lt;br&gt;external batch job · keyset paging&lt;br&gt;5-10k rows · adaptive throttle&lt;br&gt;abort: latency +20% · lag &gt;30 s&lt;br&gt;rollback: stop (idempotent)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C77700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="688" y="48" width="206" height="68" as="geometry"/></mxCell><mxCell id="7" value="VERIFY&lt;br&gt;count + checksum = 0 diff&lt;br&gt;shadow-read mismatch 0 for 24 h" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE2A8;strokeColor=#C77700;fontSize=11;" vertex="1" parent="1"><mxGeometry x="589" y="171" width="404" height="88" as="geometry"/></mxCell><mxCell id="8" value="Deploy app N+1&lt;br&gt;encrypted-only reads (flag)&lt;br&g